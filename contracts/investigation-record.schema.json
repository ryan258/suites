{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ryan-suites:InvestigationRecord:1.0.0",
  "title": "InvestigationRecord",
  "type": "object",
  "required": ["schema_version", "investigation_id", "question", "mode", "status", "premises", "evidence", "stages", "decisions", "budget", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "investigation_id": {"type": "string", "minLength": 3},
    "question": {"type": "string", "minLength": 1},
    "mode": {"enum": ["preview", "quick", "standard", "deep", "manual"]},
    "status": {"enum": ["draft", "running", "paused", "failed", "completed"]},
    "premises": {"type": "array"},
    "evidence": {"type": "array"},
    "stages": {"type": "array"},
    "decisions": {"type": "array"},
    "budget": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

