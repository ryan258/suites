{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ryan-suites:ProductionJob:1.0.0",
  "title": "ProductionJob",
  "type": "object",
  "required": ["schema_version", "job_id", "domain", "task", "status", "inputs", "outputs", "events", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 3},
    "domain": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "running", "blocked", "failed", "completed", "cancelled"]},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "events": {"type": "array"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

