{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ryan-suites:BrandPackage:1.0.0",
  "title": "BrandPackage",
  "type": "object",
  "required": ["schema_version", "package_id", "brand_id", "version", "approved_at", "identity", "voice", "audience", "approved_claims", "assets", "usage_rules", "provenance"],
  "$defs": {
    "ApprovedClaim": {
      "type": "object",
      "required": ["claim"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "Asset": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_type": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "BrandProvenance": {
      "type": "object",
      "minProperties": 1,
      "anyOf": [
        {
          "required": ["author"],
          "properties": {
            "author": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["operator"],
          "properties": {
            "operator": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["applied_by"],
          "properties": {
            "applied_by": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["actor"],
          "properties": {
            "actor": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["method"],
          "properties": {
            "method": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["decision_source"],
          "properties": {
            "decision_source": {"type": "string", "minLength": 1}
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "minLength": 3},
    "brand_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "approved_at": {"type": "string", "format": "date-time"},
    "identity": {"type": "object"},
    "voice": {"type": "object"},
    "audience": {"type": "object"},
    "approved_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/ApprovedClaim"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/Asset"}
    },
    "usage_rules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/BrandProvenance"}
    }
  },
  "additionalProperties": true
}

