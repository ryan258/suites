# OpenRouter credentials. Copy this file to .env and fill in the local secret.
# Never commit the real key.
OPENROUTER_API_KEY=

# Official OpenRouter OpenAI-compatible API endpoint and optional app attribution.
# OPENROUTER_API_KEY is pinned to this origin. Pointing OPENROUTER_BASE_URL anywhere else
# is refused unless you opt in below and supply a separately named credential, so a
# checkout-local base URL can never redirect an exported OpenRouter key to another host.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_CUSTOM_ENDPOINT=false
OPENROUTER_CUSTOM_ENDPOINT_API_KEY=
OPENROUTER_APP_URL=http://localhost
OPENROUTER_APP_TITLE=Ryan Project Suites
OPENROUTER_TIMEOUT_SECONDS=60

# Zero-cost default. OpenRouter selects from currently available free models and
# reports the resolved concrete model in each response. Pin a concrete :free slug
# only when a reproducible provider-assisted evaluation needs model stability.
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID_MODELS=false

# Role-specific routing and generation budgets.
OPENROUTER_ROLE_ORCHESTRATOR_MODEL=openrouter/free
OPENROUTER_ROLE_ORCHESTRATOR_TEMPERATURE=0.2
OPENROUTER_ROLE_ORCHESTRATOR_MAX_TOKENS=4096

OPENROUTER_ROLE_ANALYST_MODEL=openrouter/free
OPENROUTER_ROLE_ANALYST_TEMPERATURE=0.1
OPENROUTER_ROLE_ANALYST_MAX_TOKENS=6144

OPENROUTER_ROLE_REVIEWER_MODEL=openrouter/free
OPENROUTER_ROLE_REVIEWER_TEMPERATURE=0.0
OPENROUTER_ROLE_REVIEWER_MAX_TOKENS=4096

OPENROUTER_ROLE_CREATIVE_MODEL=openrouter/free
OPENROUTER_ROLE_CREATIVE_TEMPERATURE=0.7
OPENROUTER_ROLE_CREATIVE_MAX_TOKENS=6144

OPENROUTER_ROLE_ACCESSIBILITY_MODEL=openrouter/free
OPENROUTER_ROLE_ACCESSIBILITY_TEMPERATURE=0.0
OPENROUTER_ROLE_ACCESSIBILITY_MAX_TOKENS=4096
